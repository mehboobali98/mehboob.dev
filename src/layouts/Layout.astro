---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { contact } from '../site';

interface Props {
  title?: string;
  description?: string;
  // Set on blog posts so the page also describes itself as an article. Left off
  // everywhere else -- the Person block below is the site-wide identity.
  article?: {
    headline: string;
    datePublished: string;
    keywords?: string[];
  };
}

const {
  title = 'Mehboob Ali | Principal Software Engineer',
  description = 'Principal Software Engineer building backend systems, distributed workflows, and the tools that help teams ship them faster.',
  article,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mehboob Ali',
  jobTitle: 'Principal Software Engineer',
  email: `mailto:${contact.email}`,
  url: Astro.site?.origin,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
  knowsAbout: [
    'Ruby on Rails',
    'Go',
    'PostgreSQL',
    'Backend architecture',
    'Developer tooling',
    'AI coding agents',
  ],
  sameAs: [contact.github, contact.linkedin],
};

const blogPosting = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.headline,
  description,
  datePublished: article.datePublished,
  keywords: article.keywords,
  mainEntityOfPage: canonical.toString(),
  author: { '@type': 'Person', name: 'Mehboob Ali', url: Astro.site?.origin },
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1319" />
    <link rel="canonical" href={canonical} />
    <ClientRouter fallback="swap" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {blogPosting && <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />}
  </head>
  <body class="font-body antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

      // Progressive enhancement: elements start fully visible. Only if JS runs AND the
      // visitor hasn't asked for reduced motion do we hide-then-reveal them on scroll.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let observer: IntersectionObserver | undefined;

      function armReveal() {
        observer?.disconnect();
        if (prefersReducedMotion) return;

        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.remove('reveal-pending');
                observer?.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
        );

        for (const el of document.querySelectorAll('[data-reveal]')) {
          // Anything already on screen stays visible. Hiding it just to fade it back in a
          // frame later is a flash on arrival, which is the thing a soft navigation is
          // supposed to remove.
          if (el.getBoundingClientRect().top < window.innerHeight) continue;
          el.classList.add('reveal-pending');
          observer.observe(el);
        }
      }

      // Astro scrolls to a cross-page anchor by assigning location.href once the new
      // document is in place, and `scroll-behavior: smooth` turns that into a second of
      // the whole homepage sliding past. The swap wipes attributes off <html>, so the
      // override has to go on the incoming document to survive it.
      document.addEventListener('astro:before-swap', (e) => {
        (e as TransitionBeforeSwapEvent).newDocument.documentElement.style.scrollBehavior = 'auto';
      });

      // Fires on first load and again after every client-side navigation.
      document.addEventListener('astro:page-load', () => {
        document.documentElement.style.removeProperty('scroll-behavior');
        armReveal();
      });
    </script>
  </body>
</html>
