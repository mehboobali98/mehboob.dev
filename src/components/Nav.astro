---
// A thin top rail, not a column. The fixed left sidebar this replaces is the single
// most-cloned engineer-portfolio layout there is, and it was eating 300px of every
// viewport to hold six links. Root-relative hrefs, not bare fragments: a bare '#work'
// resolves against whatever page you're on, so it silently does nothing from a post.
// In page order.
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#trajectory', label: 'Trajectory' },
  { href: '/#open-source', label: 'Open Source' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#numbers', label: 'Numbers' },
];
---

<header class="sticky top-0 z-40 bg-void/85 backdrop-blur-md border-b border-line">
  <div class="shell flex items-center justify-between gap-6 px-5 sm:px-8 lg:px-20 py-3.5">
    <a href="/#top" class="tap font-display font-semibold text-paper text-[0.9375rem] tracking-tight shrink-0">
      Mehboob Ali
    </a>

    <nav class="hidden md:flex items-center gap-7">
      {links.map((l) => (
        <a href={l.href} class="tap t-micro hover:text-paper transition-colors">{l.label}</a>
      ))}
      <a
        href="/#contact"
        class="t-micro text-signal border border-line-strong hover:border-signal rounded-sm px-3 py-1.5 transition-colors"
      >
        Contact
      </a>
    </nav>

    <!-- Below md the rail keeps only the two things a visitor actually needs from a
         sticky bar. The full set is a scroll away, not hidden behind a menu. -->
    <nav class="flex md:hidden items-center gap-5">
      <a href="/#work" class="tap t-micro hover:text-paper transition-colors">Work</a>
      <a href="/#contact" class="t-micro text-signal border border-line-strong rounded-sm px-2.5 py-1.5">Contact</a>
    </nav>
  </div>
</header>
