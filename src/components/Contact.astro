---
import { contact, mailto } from '../site';

// Five equally-weighted resume variants made the visitor do the sorting. Most people who
// reach this section want one file, so one is offered outright and the tailored variants
// sit behind a disclosure for the recruiter who is hiring for a specific shape of role.
// PDF stays first everywhere because it renders the same on every machine, including a
// phone; the DOCX is there for ATS uploads that want an editable file.
const base = '/resume/Mehboob_Ali_';

const primary = { label: 'Staff / Principal / Tech Lead', file: 'Staff_Principal_Tech_Lead_Resume' };

const variants = [
  { label: 'Backend / Platform', file: 'Backend_Platform_Resume' },
  { label: 'Applied AI & Developer Tools', file: 'Applied_AI_LLM_Resume' },
  { label: 'Developer Productivity / AI Enablement', file: 'Developer_Productivity_AI_Enablement_Resume' },
  { label: 'Full-Stack / Product', file: 'Fullstack_Product_Resume' },
];
---

<section id="contact" class="bg-ink border-t border-line">
  <div class="band shell section-grid">
    <div class="measure">
      <h2 class="t-display-2 text-paper">
        Open to remote or relocation. Email is the fastest way to reach me.
      </h2>

      <a
        href={mailto}
        class="inline-block mt-8 font-display wonk italic text-2xl sm:text-3xl text-signal hover:underline break-all"
      >
        {contact.email}
      </a>
    </div>

    <div class="xl:pt-3">
      <p class="t-micro mb-4">Resume</p>

      <div class="p-6 border border-line rounded-lg bg-surface">
        <p class="font-mono text-[11px] text-quiet">{primary.label}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a
            href={`${base}${primary.file}.pdf`}
            download
            class="px-5 py-2.5 bg-signal text-ink font-medium text-sm rounded-sm hover:bg-signal/90 transition-colors"
          >
            Download PDF
          </a>
          <a
            href={`${base}${primary.file}.docx`}
            download
            class="tap font-mono text-xs text-quiet hover:text-signal transition-colors"
          >
            DOCX
          </a>
        </div>
      </div>

      <details class="mt-5">
        <summary class="tap font-mono text-xs text-quiet hover:text-signal transition-colors cursor-pointer">
          Four more, tailored to the role
        </summary>
        <div class="mt-2 flex flex-col">
          {variants.map((r) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3 border-t border-line">
              <p class="text-sm text-paper/80">{r.label}</p>
              <p class="flex gap-4 font-mono text-xs shrink-0">
                <a href={`${base}${r.file}.pdf`} download class="tap text-signal hover:underline">PDF &darr;</a>
                <a href={`${base}${r.file}.docx`} download class="tap text-quiet hover:text-signal transition-colors">DOCX</a>
              </p>
            </div>
          ))}
          <div class="border-t border-line"></div>
        </div>
      </details>
    </div>
  </div>
</section>

<footer class="bg-void border-t border-line">
  <div class="shell px-5 sm:px-8 lg:px-20 py-9 flex flex-col sm:flex-row gap-4 sm:justify-between font-mono text-xs text-quiet">
  <p>Mehboob Ali, Lahore, Pakistan</p>
  <div class="flex gap-6">
    <a href={contact.github} target="_blank" rel="noopener" class="tap hover:text-signal transition-colors">GitHub</a>
    <a href={contact.linkedin} target="_blank" rel="noopener" class="tap hover:text-signal transition-colors">LinkedIn</a>
    <a href={mailto} class="tap hover:text-signal transition-colors">Email</a>
  </div>
  </div>
</footer>
