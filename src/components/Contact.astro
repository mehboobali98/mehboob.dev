---
import { contact, mailto } from '../site';

// One primary resume keeps the positioning the same here as everywhere else; the
// full-stack variant sits behind a disclosure for Rails + React roles. Both are the
// phone-free public builds of the LaTeX sources, so there is no DOCX to offer.
const base = '/resume/Mehboob_Ali_';

const primary = { label: 'Senior Backend Engineer (Ruby on Rails)', file: 'Resume' };

const variants = [
  { label: 'Full-stack (Rails + React)', file: 'Resume_Fullstack' },
];

// Each principle points at the thing on the site that shows it. Without that, three
// sentences about how someone works could sit on anyone's portfolio.
const principles = [
  {
    text: 'I write down the messy part first. Once the uncertainty is visible, splitting the work gets much easier.',
    proof: { label: 'The spec auditor', href: '/blog/three-agents-that-dont-trust-each-other/' },
  },
  {
    text: "I don't disappear after release. I stay close to the logs, support questions, and awkward edge cases.",
    proof: { label: 'N+1 warnings routed to Slack', href: '#performance-feedback' },
  },
  {
    text: 'If I have to explain the same manual fix twice, I start looking for the tool that removes it.',
    proof: { label: 'Why rmine exists', href: '/blog/designing-a-cli-for-agents/' },
  },
];
---

<section class="bg-ink border-t border-line">
  <div id="now" class="bg-surface border-b border-line">
    <div class="shell px-[clamp(1.25rem,5vw,5rem)] py-10 sm:py-12 grid lg:grid-cols-[10rem_minmax(0,1fr)] gap-6 lg:gap-10 items-start">
      <h2 class="marker">How I work</h2>
      <ol class="grid sm:grid-cols-3 gap-px border border-line rounded-md bg-line overflow-hidden">
        {principles.map((principle, index) => (
          <li class="bg-surface px-5 py-5 sm:min-h-32">
            <span aria-hidden="true" class="font-mono text-xs text-signal">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="mt-3 text-paper/85 leading-relaxed">{principle.text}</p>
            <a href={principle.proof.href} class="tap inline-block mt-3 font-mono text-xs text-signal hover:underline">
              {principle.proof.label} &rarr;
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div id="contact" class="band band--dense shell section-grid">
    <div class="measure">
      <h2 class="t-display-2 text-paper">
        Open to remote or relocation. Email is the fastest way to reach me.
      </h2>

      <a
        href={mailto}
        class="inline-block mt-8 font-display wonk text-2xl sm:text-3xl text-signal hover:underline break-all"
      >
        {contact.email}
      </a>
    </div>

    <div class="xl:pt-3">
      <p class="t-micro mb-4">Resume</p>

      <div class="p-6 border border-line rounded-lg bg-surface">
        <p class="font-mono text-xs text-quiet">{primary.label}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a
            href={`${base}${primary.file}.pdf`}
            download
            class="px-5 py-2.5 bg-signal text-ink font-medium text-sm rounded-sm hover:bg-signal/90 transition-colors"
          >
            Download PDF
          </a>
        </div>
      </div>

      <details class="mt-5">
        <summary class="tap font-mono text-xs text-quiet hover:text-signal transition-colors cursor-pointer">
          Full-stack variant
        </summary>
        <div class="mt-2 flex flex-col">
          {variants.map((r) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3 border-t border-line">
              <p class="text-sm text-paper/80">{r.label}</p>
              <p class="flex gap-4 font-mono text-xs shrink-0">
                <a href={`${base}${r.file}.pdf`} download class="tap text-signal hover:underline">PDF &darr;</a>
              </p>
            </div>
          ))}
          <div class="border-t border-line"></div>
        </div>
      </details>
    </div>
  </div>
</section>

<footer class="bg-void border-t border-line">
  <div class="shell px-5 sm:px-8 lg:px-20 py-9 flex flex-col sm:flex-row gap-4 sm:justify-between font-mono text-xs text-quiet">
    <p>Mehboob Ali, Lahore, Pakistan</p>
    <div class="flex gap-6">
      <a href={contact.github} target="_blank" rel="noopener" class="tap hover:text-signal transition-colors">GitHub</a>
      <a href={contact.linkedin} target="_blank" rel="noopener" class="tap hover:text-signal transition-colors">LinkedIn</a>
      <a href={mailto} class="tap hover:text-signal transition-colors">Email</a>
    </div>
  </div>
</footer>
