---
import CmdbGraph from './CmdbGraph.astro';
import RackEditor from './RackEditor.astro';
import WorkflowGraph from './WorkflowGraph.astro';
import { caseStudies } from '../data/caseStudies';

const [sync, workflow, cmdb] = caseStudies;
const workflowPreviewFacts = workflow.facts.filter((fact) => ['Team', 'Status'].includes(fact.label));
const cmdbPreviewFacts = cmdb.facts.filter((fact) => ['Team', 'Duration'].includes(fact.label));
---

<section id="work" class="bg-ink border-t border-line">
  <div class="band band--compact shell">
    <p class="marker mb-6">Selected work</p>
    <h2 class="t-display-2 text-paper max-w-[22ch]">Three projects I know inside out.</h2>
    <p class="mt-6 t-meta measure">
      All three are part of{' '}
      <a href="https://ezo.io/assetsonar/" target="_blank" rel="noopener" class="text-signal underline underline-offset-2">AssetSonar</a>,
      the IT asset management product I work on at EZO.
    </p>
  </div>

  <article id={sync.id} data-reveal class="border-t border-line bg-ink">
    <div class="band band--compact shell grid xl:grid-cols-[minmax(0,0.82fr)_minmax(30rem,1.18fr)] gap-10 xl:gap-20 items-center">
      <div class="measure min-w-0">
        <p class="t-micro">{sync.eyebrow}</p>
        <h3 class="mt-4 t-display-3 text-paper">{sync.title}</h3>
        <p class="mt-5 text-paper/80 leading-relaxed">{sync.description}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {sync.stack.map((item) => <span class="tech-pill">{item}</span>)}
        </div>
        <a href={`/work/${sync.slug}/`} class="edge-link tap mt-6 font-mono text-xs text-signal hover:underline">
          Open the case study &rarr;
        </a>
      </div>

      <div class="runtime-panel" role="group" aria-label="Runtime improvement" data-sync-panel>
        <dl>
          <dt>Before</dt>
          <dd><span class="runtime-figure">12–15</span> <span class="runtime-unit">hours</span><span class="runtime-bar" aria-hidden="true"></span></dd>
        </dl>
        <dl class="runtime-after">
          <dt>After</dt>
          <dd><span class="runtime-figure">Under 1</span> <span class="runtime-unit">hour</span><span class="runtime-bar" aria-hidden="true"></span></dd>
        </dl>
        <button type="button" class="scene-replay" data-scene-replay aria-label="Replay the sync animation" hidden>Replay</button>
      </div>
    </div>
  </article>

  <article id={workflow.id} data-reveal class="border-t border-line bg-surface">
    <div class="band band--compact shell">
      <div class="grid xl:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-10 xl:gap-20 items-end">
        <div class="measure">
          <p class="t-micro">{workflow.eyebrow}</p>
          <h3 class="mt-4 t-display-3 text-paper">{workflow.title}</h3>
          <p class="mt-5 text-paper/80 leading-relaxed">{workflow.description}</p>
        </div>
        <dl class="evidence-row">
          {workflowPreviewFacts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="workflow-panel scene-host mt-10" data-scene="workflow">
        <WorkflowGraph />
        <button type="button" class="scene-replay" data-scene-replay hidden>Replay</button>
      </div>

      <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2">
          {workflow.stack.map((item) => <span class="tech-pill">{item}</span>)}
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {workflow.proof && (
            <a href={workflow.proof.href} target="_blank" rel="noopener" class="proof-link tap">
              {workflow.proof.label} &rarr;
            </a>
          )}
          <a href={`/work/${workflow.slug}/`} class="edge-link tap font-mono text-xs text-signal hover:underline">
            Open the case study &rarr;
          </a>
        </div>
      </div>
    </div>
  </article>

  <article id={cmdb.id} data-reveal class="border-t border-line bg-ink">
    <div class="band band--compact shell grid xl:grid-cols-[minmax(32rem,1.15fr)_minmax(0,0.85fr)] gap-10 xl:gap-20 items-center">
      <div class="cmdb-panel scene-host min-w-0 order-2 xl:order-1" data-scene="cmdb">
        <CmdbGraph />
        <button type="button" class="scene-replay" data-scene-replay hidden>Replay</button>
      </div>
      <div class="measure min-w-0 order-1 xl:order-2">
        <p class="t-micro">{cmdb.eyebrow}</p>
        <h3 class="mt-4 t-display-3 text-paper">{cmdb.title}</h3>
        <p class="mt-5 text-paper/80 leading-relaxed">{cmdb.description}</p>
        <dl class="evidence-row mt-7">
          {cmdbPreviewFacts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
          {cmdb.proof && (
            <a href={cmdb.proof.href} target="_blank" rel="noopener" class="proof-link tap">
              {cmdb.proof.label} &rarr;
            </a>
          )}
          <a href={`/work/${cmdb.slug}/`} class="edge-link tap font-mono text-xs text-signal hover:underline">
            Open the case study &rarr;
          </a>
        </div>
      </div>
    </div>
  </article>

  <article id="rack-editor" data-reveal class="border-t border-line bg-surface">
    <div class="band band--compact shell grid xl:grid-cols-[minmax(0,0.82fr)_minmax(30rem,1.18fr)] gap-10 xl:gap-20 items-center">
      <div class="measure min-w-0">
        <p class="t-micro">Also built</p>
        <h3 class="mt-4 t-display-3 text-paper">A server rack layout editor</h3>
        <p class="mt-5 text-paper/80 leading-relaxed">
          Both halves are mine: the Rails API that saves a layout's racks and devices in one
          transaction, and the React editor on top of it.
        </p>
        <p class="mt-4 text-paper/80 leading-relaxed">
          Drop a device on a rack and it lands in the nearest free slot tall enough to hold it,
          or the editor says there's no room. Drag one onto occupied units and it goes back
          where it was.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {['Ruby on Rails', 'React', 'TypeScript', 'React Flow'].map((item) => <span class="tech-pill">{item}</span>)}
        </div>
      </div>

      <div class="rack-panel scene-host min-w-0" data-scene="rack">
        <RackEditor />
        <button type="button" class="scene-replay" data-scene-replay hidden>Replay</button>
      </div>
    </div>
  </article>
</section>

<script>
  import { mountScene } from '../lib/motion/mount';
  import { onAstroLifecycle } from '../lib/motion/trigger';

  const scenes: [string, string, () => Promise<import('../lib/motion/mount').SceneModule>][] = [
    ['[data-sync-panel]', 'sync', () => import('../lib/motion/syncScene').then((m) => ({ createScene: m.createSyncScene }))],
    ['[data-scene="cmdb"]', 'CMDB', () => import('../lib/motion/cmdbScene')],
    ['[data-scene="workflow"]', 'workflow', () => import('../lib/motion/workflowScene')],
    ['[data-scene="rack"]', 'rack editor', () => import('../lib/motion/rackScene')],
  ];

  onAstroLifecycle(() => {
    const teardowns = scenes.flatMap(([selector, name, load]) => {
      const host = document.querySelector<HTMLElement>(selector);
      const button = host?.querySelector<HTMLButtonElement>('[data-scene-replay]');
      return host && button ? [mountScene(host, button, name, load)] : [];
    });
    return () => teardowns.forEach((t) => t());
  });
</script>

<style>
  .runtime-panel {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding: clamp(1.5rem, 5vw, 4rem);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }

  .runtime-panel dt,
  .evidence-row dt {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-quiet);
  }

  .runtime-panel dd {
    margin: 0.55rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-quiet);
  }

  .runtime-figure {
    font-family: var(--font-display);
    font-variation-settings: "WONK" 1;
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    color: var(--color-paper);
  }

  .runtime-bar {
    display: block;
    height: 0.625rem;
    margin-top: 1rem;
    border-radius: 2px;
    background: var(--color-line-strong);
  }

  .runtime-after .runtime-figure {
    color: var(--color-mysql);
  }

  .runtime-after .runtime-bar {
    width: calc(100% / 12);
    min-width: 0.625rem;
    background: var(--color-mysql);
  }

  .workflow-panel,
  .cmdb-panel,
  .rack-panel {
    padding: clamp(1.25rem, 4vw, 3.5rem);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-void);
  }

  .evidence-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 0.4rem;
    overflow: hidden;
  }

  .evidence-row > div {
    min-width: 0;
    padding: 1rem;
    background: var(--color-ink);
  }

  .evidence-row dd {
    margin: 0.45rem 0 0;
    color: var(--color-paper);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .tech-pill {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
  }

</style>
