---
// The Workflow Automation Engine is publicly a node canvas: you connect triggers to
// conditions to actions. So the site's node motif isn't a metaphor here, it's the shape of
// the product being described. Drawn from the public documentation, linked beside it.
const nodes = [
  { x: 22, y: 60, w: 104, label: 'Trigger', sub: 'asset.updated', kind: 'signal' },
  { x: 166, y: 60, w: 104, label: 'Condition', sub: 'status = idle', kind: 'quiet' },
  { x: 310, y: 22, w: 104, label: 'Action', sub: 'notify owner', kind: 'quiet' },
  { x: 310, y: 98, w: 104, label: 'Action', sub: 'open ticket', kind: 'signal' },
];
---

<figure>
  <svg viewBox="0 0 432 152" class="w-full h-auto" role="img" aria-labelledby="wf-title">
    <title id="wf-title">
      A workflow automation graph: a trigger feeds a condition, which branches into two actions.
    </title>

    <g stroke="var(--color-line-strong)" stroke-width="1" fill="none">
      <path d="M126,84 L166,84" />
      <path d="M270,84 C290,84 290,46 310,46" />
      <path d="M270,84 C290,84 290,122 310,122" />
    </g>

    {nodes.map((n) => (
      <>
        <rect
          x={n.x}
          y={n.y}
          width={n.w}
          height="48"
          rx="4"
          fill="var(--color-surface)"
          stroke={n.kind === 'signal' ? 'var(--color-signal)' : 'var(--color-line-strong)'}
          stroke-width="1"
        />
        <text
          x={n.x + 12}
          y={n.y + 20}
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.08em"
          fill={n.kind === 'signal' ? 'var(--color-signal)' : 'var(--color-quiet)'}
        >{n.label.toUpperCase()}</text>
        <text
          x={n.x + 12}
          y={n.y + 36}
          font-family="var(--font-mono)"
          font-size="10"
          fill="var(--color-paper)"
        >{n.sub}</text>
      </>
    ))}
  </svg>
</figure>
