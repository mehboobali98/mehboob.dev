---
import { desktopEdges, mobileEdges, mobileNodes, nodes } from '../data/workflowGraph';

const stroke = (kind: string) => (kind === 'lit' ? 'var(--color-react)' : 'var(--color-line-strong)');
const ink = (kind: string) => (kind === 'lit' ? 'var(--color-react)' : 'var(--color-quiet)');
---

<figure>
  <svg
    viewBox="0 0 476 160"
    class="hidden sm:block w-full h-auto"
    role="img"
    aria-labelledby="wf-title wf-desc"
    data-scene-graphic
    data-layout="desktop"
  >
    <title id="wf-title">
      A workflow automation graph: a trigger feeds a condition, which branches into two actions.
    </title>
    <desc id="wf-desc">
      A member offboarding trigger reaches an inactive-status condition. The condition branches
      to an Entra user update and to opening a ticket.
    </desc>

    <g stroke="var(--color-line-strong)" stroke-width="1" fill="none">
      {desktopEdges.map((d) => <path d={d} />)}
    </g>

    {nodes.map((n) => (
      <>
        <rect
          x={n.x}
          y={n.y}
          width={n.w}
          height="48"
          rx="4"
          fill="var(--color-surface)"
          stroke={stroke(n.kind)}
          stroke-width="1"
        />
        <text
          x={n.x + 12}
          y={n.y + 20}
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.08em"
          fill={ink(n.kind)}
        >{n.label.toUpperCase()}</text>
        <text
          x={n.x + 12}
          y={n.y + 36}
          font-family="var(--font-mono)"
          font-size="10"
          fill="var(--color-paper)"
        >{n.sub}</text>
      </>
    ))}
  </svg>

  <svg
    viewBox="0 0 300 306"
    class="sm:hidden w-full h-auto"
    role="img"
    aria-labelledby="wf-title-m"
    data-scene-graphic
    data-layout="phone"
  >
    <title id="wf-title-m">
      A member offboarding trigger reaches an inactive-status condition, which branches to an
      Entra user update and to opening a ticket.
    </title>

    <g stroke="var(--color-line-strong)" stroke-width="1.5" fill="none">
      {mobileEdges.map((d) => <path d={d} />)}
    </g>

    {mobileNodes.map((n) => (
      <>
        <rect
          x={n.x + 0.75}
          y={n.y + 0.75}
          width={n.w - 1.5}
          height="52.5"
          rx="5"
          fill="var(--color-surface)"
          stroke={stroke(n.kind)}
          stroke-width="1.5"
        />
        <text
          x={n.x + 14}
          y={n.y + 22}
          font-family="var(--font-mono)"
          font-size="12"
          letter-spacing="0.08em"
          fill={ink(n.kind)}
        >{n.label.toUpperCase()}</text>
        <text
          x={n.x + 14}
          y={n.y + 41}
          font-family="var(--font-mono)"
          font-size="13"
          fill="var(--color-paper)"
        >{n.sub}</text>
      </>
    ))}
  </svg>
</figure>
