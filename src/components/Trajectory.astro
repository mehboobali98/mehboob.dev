---
const roles = [
  {
    title: 'Software Engineer',
    dates: 'Aug 2021 – Jan 2023',
    scope: 'Backend engineering',
    proof: 'Rebuilt the device sync from 12–15 hours to under one hour and built the audit-trail engine.',
  },
  {
    title: 'Software Engineer (L2)',
    dates: 'Jan 2023 – Jul 2024',
    scope: 'Feature ownership',
    proof: 'Moved from implementing specifications to writing and owning them across four product initiatives.',
  },
  {
    title: 'Senior Software Engineer',
    dates: 'Jul 2024 – Jul 2026',
    scope: 'Technical lead',
    proof: 'Led delivery across Workflow Automation, CMDB / IT Graph, and AWS cloud integration.',
  },
  {
    title: 'Principal Software Engineer',
    dates: 'Jul 2026 – now',
    scope: 'Architecture and leverage',
    proof: "Reviews, production escalation, technical direction, and tooling that changes how the wider team ships.",
    current: true,
  },
];

// Career progression and internal leverage are one story: the role grew from delivering
// features to improving the system around delivery. Keeping both in this section prevents
// two consecutive, near-identical timeline sections on the homepage.
const leverage = [
  {
    title: 'Conventions that arrive with the branch',
    meta: '12 rules · 3 skills · merged June 2026',
    body: "Rails and React rules now travel with every branch, so engineers don't have to reconstruct the same conventions from memory.",
  },
  {
    title: 'Guardrails built into setup',
    meta: '3 hooks · 4 products · automatic updates',
    body: 'Setup installs checks for debugger statements, conflict markers, lockfile drift, and Ruby syntax. Ticket references are added automatically.',
  },
  {
    title: 'Performance feedback at the source',
    meta: 'Bullet · Slack · staging',
    body: 'N+1 warnings reach Slack with the request, suggested fix, stack frames, and the exact GitHub line before the regression reaches production.',
  },
];
---

<section id="trajectory" class="bg-surface border-t border-line">
  <div class="band band--compact shell trajectory-grid">
    <div class="min-w-0">
      <div class="measure">
        <p class="marker mb-6">Career</p>
        <h2 class="t-display-2 text-paper">
          How the job changed.
        </h2>
      </div>

      <ol class="mt-8 flex flex-col border-b border-line">
        {roles.map((role) => (
          <li class:list={['career-step border-t border-line py-4 sm:py-5', role.current && 'is-current']}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1">
              <h3 class="font-display wonk font-semibold text-xl text-paper">{role.title}</h3>
              <p class="font-mono text-xs text-quiet shrink-0">{role.dates}</p>
            </div>
            <p class="mt-2 t-micro">{role.scope}</p>
            <p class="mt-2 text-[0.8125rem] sm:text-sm leading-relaxed text-paper/70">{role.proof}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="min-w-0 xl:pt-1">
      <p class="t-micro mb-3">What stayed behind</p>
      <p class="max-w-[34rem] text-paper/70 leading-relaxed">
        The job moved from building features to changing how features get built. These are
        three changes the team still carries into new work.
      </p>

      <ol class="mt-6 sm:mt-8 grid gap-3 sm:gap-4">
        {leverage.map((item, index) => (
          <li data-reveal class="impact-card rounded-lg border border-line bg-ink/45 p-5 sm:p-7">
            <div class="flex items-start gap-4">
              <span aria-hidden="true" class="font-mono text-xs text-signal pt-1">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="t-display-3 text-paper">{item.title}</h3>
                <p class="mt-2 font-mono text-xs text-quiet">{item.meta}</p>
                <p class="mt-3 sm:mt-4 text-[0.8125rem] sm:text-sm leading-relaxed text-paper/75">{item.body}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .trajectory-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .trajectory-grid {
      gap: 4rem;
    }
  }

  @media (min-width: 1280px) {
    .trajectory-grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      gap: 6rem;
      align-items: start;
    }
  }

  .career-step {
    position: relative;
    padding-left: 1.75rem;
  }

  .career-step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.75rem;
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 9999px;
    background: var(--color-surface);
  }

  .career-step.is-current::before {
    border-color: var(--color-signal);
    background: var(--color-signal);
    box-shadow: 0 0 0 5px var(--color-signal-dim);
  }

  .impact-card {
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .impact-card:hover {
    border-color: var(--color-line-strong);
    background: color-mix(in srgb, var(--color-ink) 65%, transparent);
  }
</style>
