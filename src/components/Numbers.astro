---
import DeliveryChart from './DeliveryChart.astro';

// Every number here used to be behind a hover, and the section opened on "5 years",
// the least interesting figure in the set. They are all plain text now and the section
// needs no JavaScript at all.
//
// The graph is not plotted against an axis, because there is no per-year breakdown
// behind these five numbers to plot honestly. Faking a trend line out of five unrelated
// quantities would be inventing data. It reads as what it is: five points on a path.
const stats = [
  {
    n: '5',
    label: 'years',
    desc: 'The short version: I started out implementing specs at 7Vals. Somewhere in there I started writing them instead.',
  },
  {
    n: '276',
    label: 'features shipped',
    desc: '72% of them live in production; the rest killed, deprioritized, or still in flight.',
    proportion: 72,
  },
  {
    n: '22',
    label: 'Key Features',
    desc: 'Product-flagged, go-to-market work. Not the routine maintenance stuff.',
  },
  {
    n: '3',
    label: 'promotions',
    desc: 'Software Engineer to Principal. Four titles, five years.',
  },
  {
    n: '7',
    label: 'months',
    desc: 'Zero to production on the CMDB module. Newest number on this list.',
  },
];
---

<section id="numbers" class="bg-ink">
  <div class="band band--dense shell">
    <p class="marker mb-6">By the numbers</p>
    <h2 class="t-display-2 text-paper max-w-[20ch]">
      I built a tool to analyze my own delivery history. This is what it found.
    </h2>
    <p class="mt-6 text-paper/75 leading-relaxed measure">
      <a href="#open-source" class="text-signal hover:underline">rmine</a>, a CLI I wrote, pulled
      five years of my own tickets and time logs and scored them.
    </p>
  </div>

  <!-- Full-bleed. The numbers are the loudest thing in this section, so they get the
       whole width and their own ground rather than sitting politely in a column. -->
  <div class="bg-surface border-y border-line">
    <dl class="shell grid grid-cols-2 lg:grid-cols-5 gap-px bg-line">
      {stats.map((s) => (
        <div class="bg-surface px-6 sm:px-8 py-10 lg:py-14">
          <dt class="sr-only">{s.label}</dt>
          <dd class="m-0">
            <p class="font-display wonk font-black text-signal leading-none text-[3.25rem] lg:text-[4rem]">
              {s.n}
            </p>
            <p class="mt-3 font-mono text-paper" style="font-size: var(--type-meta)">{s.label}</p>
            {s.proportion && (
              <div class="mt-3 max-w-[10rem]">
                <div class="h-1 rounded-full bg-surface-2 overflow-hidden">
                  <div class="h-full bg-signal" style={`width:${s.proportion}%`}></div>
                </div>
                <p class="mt-2 t-micro">{s.proportion}% in production</p>
              </div>
            )}
            <p class="mt-4 text-paper/60 leading-relaxed" style="font-size: var(--type-meta)">
              {s.desc}
            </p>
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <!-- The shape behind the totals, and the method that produced them. -->
  <div class="band band--dense shell section-grid">
    <div>
      <p class="t-micro mb-5">Features per year</p>
      <DeliveryChart />
    </div>
    <div class="measure-sm">
      <p class="t-micro mb-3">Method</p>
      <p class="text-paper/70 leading-relaxed" style="font-size: var(--type-meta)">
        Closed issues assigned to me across five years, exported
        with <code class="font-mono text-[0.9em] text-paper/85">-o json</code>, then
        grouped by tracker and by the product's own feature flag. The tool is open source;
        the Redmine instance behind these numbers is my employer's, so you can read the
        method but you can't run it. Where a number is a range or an estimate, it's
        written as one.
      </p>
      <a
        href="https://github.com/mehboobali98/rmine"
        target="_blank"
        rel="noopener"
        class="proof-link tap mt-2"
      >
        Read the source on GitHub
      </a>
    </div>
  </div>
</section>
