---
import DeliveryChart from './DeliveryChart.astro';

// Every number here used to be behind a hover, and the section opened on "5 years",
// the least interesting figure in the set. They are all plain text now and the section
// needs no JavaScript at all.
//
// Keep the three figures that add information on the homepage. Promotion count already
// appears in the hero, while "five years" is context rather than evidence. The detailed
// case pages carry the rest.
const stats = [
  {
    // Only tickets I was a developer on and that reached Deployed. Tickets I only wrote,
    // and ones still open or parked on staging, are left out.
    n: '170',
    label: 'features deployed',
    desc: 'Built by me and deployed, across AssetSonar and the EZOfficeInventory line, 2021 to mid-2026.',
  },
  {
    n: '20',
    label: 'flagship releases',
    desc: 'Product-flagged launches, deployed. Not the routine maintenance stuff.',
  },
  {
    n: '7',
    label: 'months to production',
    desc: 'The CMDB module, from architecture to a production release.',
  },
];
---

<section id="numbers" class="bg-ink border-t border-line">
  <div class="band band--compact shell">
    <p class="marker mb-6">By the numbers</p>
    <h2 class="t-display-2 text-paper max-w-[22ch]">
      I checked five years of tickets. Here’s what I found.
    </h2>
    <p class="mt-6 text-paper/75 leading-relaxed measure">
      <!-- Underlined always: amber sits at 1.05:1 against the surrounding text, so hover
           alone left colour as the only cue. -->
      <a href="#open-source" class="text-signal underline underline-offset-2">rmine</a>, a CLI I wrote,
      pulled the history and did the counting.
    </p>
  </div>

  <!-- Full-bleed. The numbers are the loudest thing in this section, so they get the
       whole width and their own ground rather than sitting politely in a column. -->
  <div class="bg-surface border-y border-line">
    <dl class="shell grid grid-cols-2 lg:grid-cols-3 gap-px bg-line">
      <!-- The lead metric spans the full phone width. At lg all three form one row. -->
      {stats.map((s, index) => (
        <div class:list={[
          'bg-surface px-6 sm:px-8 py-9 lg:py-10',
          index === 0 && 'col-span-2 lg:col-span-1',
        ]}>
          <dt class="sr-only">{s.label}</dt>
          <dd class="m-0">
            <p class="font-display wonk font-black text-signal leading-none text-[3.25rem] lg:text-[4rem]">
              {s.n}
            </p>
            <p class="mt-3 font-mono text-paper" style="font-size: var(--type-meta)">{s.label}</p>
            <p
              class:list={[
                'mt-4 text-paper/60 leading-relaxed',
                index !== 0 && 'hidden sm:block',
              ]}
              style="font-size: var(--type-meta)"
            >
              {s.desc}
            </p>
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <!-- The shape behind the totals, and the method that produced them. -->
  <div class="band band--compact shell section-grid">
    <div>
      <p class="t-micro mb-5">Features deployed per year</p>
      <DeliveryChart />
    </div>
    <details class="measure-sm border-y border-line py-1">
      <summary class="tap cursor-pointer font-mono text-xs text-quiet hover:text-signal transition-colors">
        How I counted this
      </summary>
      <div class="pb-4">
        <p class="text-paper/70 leading-relaxed" style="font-size: var(--type-meta)">
          Feature tickets I worked on as a developer, exported
          with <code class="font-mono text-[0.9em] text-paper/85">-o json</code>, keeping
          only the ones that were deployed, then grouped by the product's own feature flag.
          The tool is open source and the tickets are private, so you can read the method
          but you can't rerun it. Where a number is a range or an estimate, it's written
          as one.
        </p>
        <a
          href="https://github.com/mehboobali98/rmine"
          target="_blank"
          rel="noopener"
          class="proof-link tap mt-2"
        >
          Read the source on GitHub
        </a>
      </div>
    </details>
  </div>
</section>
