---
import { contact, mailto } from '../site';

// The rest of the graph. Everything else in five years that isn't one of the four.
import { mesh, meshNodes, start, work } from '../data/heroGraph';

// The signature. Five years of work drawn the way the CMDB draws infrastructure: one
// traversal through a quiet mesh, with the things he actually built as the labelled
// nodes on it. It is the relationship model applied to the person who wrote it, which
// is the one element on this page that no other portfolio could lift and reuse.
//
// The nodes are also the page's table of contents. Each one is a real anchor.
const pathD = [start, ...work].map((n, i) => `${i === 0 ? 'M' : 'L'}${n.x},${n.y}`).join(' ');

// Short labels on purpose: three of these have to sit on one line inside the type
// column, and the long version of each is two screens down in the numbers band.
// The compact layout for narrow screens. Same four items, re-laid out for a phone rather
// than scaled down: reusing the desktop coordinates would put 15px labels at about 8px.
const mobileNodes = work.map((n, i) => ({
  label: n.label,
  // Not drawn at this size; used only for the link's accessible name.
  note: n.note,
  href: n.href,
  x: 30 + i * 88,
  y: [78, 40, 62, 30][i],
}));
const mobilePath = mobileNodes.map((n, i) => `${i === 0 ? 'M' : 'L'}${n.x},${n.y}`).join(' ');

const evidence = [
  { n: '12–15h → <1h', label: 'device sync', mobileLabel: 'device sync' },
  { n: '8', label: 'engineers led', mobileLabel: 'team led' },
  { n: '3', label: 'promotions in five years', mobileLabel: 'promotions' },
];

const primaryResume = '/resume/Mehboob_Ali_Resume.pdf';
---

<section id="top" class="hero" data-hero>
  <svg class="hero-burst" data-hero-burst aria-hidden="true"></svg>
  <div class="shell w-full px-[clamp(1.25rem,5vw,5rem)] py-12 lg:py-8 xl:py-10 lg:min-h-[calc(100svh-3.5rem)] flex items-center">
    <div class="hero-content w-full grid lg:grid-cols-[minmax(0,1.18fr)_minmax(0,0.82fr)] gap-12 xl:gap-16 items-center">
      <div>
        <p class="marker mb-5">Senior Backend Engineer · Principal Engineer at EZO</p>

        <h1 class="t-display-1 text-paper max-w-[39rem]">
          I build backend systems, then build the tools to understand them.
        </h1>

        <p class="mt-5 text-paper/80 leading-relaxed max-w-[34rem]" style="font-size: var(--type-body-lg)">
          At EZO, I lead our workflow automation work. Before that, I took the CMDB from an idea to production.
          I also build small tools for the parts of engineering work that are still too manual.
        </p>

        <p class="mt-4 t-meta flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>Lahore, Pakistan · Open to remote or relocation</span>
          <span aria-hidden="true" class="hidden sm:inline text-line-strong">/</span>
          <a href={mailto} class="tap text-paper/75 hover:text-signal transition-colors">{contact.email}</a>
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#work"
            class="px-6 py-3 bg-signal text-ink font-medium rounded-sm hover:bg-signal/90 transition-colors"
          >
            See the work
          </a>
          <a
            href={primaryResume}
            download
            class="px-6 py-3 border border-line-strong text-paper font-medium rounded-sm hover:border-signal hover:text-signal transition-colors"
          >
            Download my resume
          </a>
        </div>

        <dl class="mt-7 grid grid-cols-[minmax(0,1.65fr)_minmax(0,0.6fr)_minmax(0,0.95fr)] sm:grid-cols-3 gap-x-4 sm:gap-x-7 border-t border-line pt-5 max-w-[38rem]">
          {evidence.map((e) => (
            <div class="min-w-0">
              <dd data-hero-stat class="font-display wonk font-black text-[clamp(1.15rem,2.2vw,1.75rem)] text-signal leading-none m-0 whitespace-nowrap">{e.n}</dd>
              <dt class="mt-1.5 t-micro leading-snug">
                <span class="sm:hidden">{e.mobileLabel}</span>
                <span class="hidden sm:inline">{e.label}</span>
              </dt>
            </div>
          ))}
        </dl>
      </div>

      <!-- No role="img": it hides the element's children from assistive tech, which would
           leave these four links focusable but unnamed. -->
      <div class="hidden lg:block" style="--path-len: 1600">
        <script is:inline>
          (function () {
            var host = document.currentScript && document.currentScript.parentElement;
            if (!host || window.__mbHeroPlayed) return;
            if (!matchMedia('(min-width: 1024px)').matches) return;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            host.setAttribute('data-hero-pending', '');
            setTimeout(function () { host.removeAttribute('data-hero-pending'); }, 2500);
          })();
        </script>
        <svg viewBox="0 0 624 470" class="w-full h-auto" aria-labelledby="hero-graph-title" data-hero-graph>
          <title id="hero-graph-title">
            A graph of four things built over five years: a sync pipeline, a CMDB, the rmine
            CLI, and a workflow automation engine, connected as one traversal.
          </title>

          <g data-hero-static stroke="var(--color-line)" stroke-width="1" stroke-opacity="0.75">
            {mesh.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
          </g>
          <g data-hero-static fill="var(--color-line-strong)">
            {meshNodes.map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.5" />)}
          </g>

          <path
            class="hero-path"
            data-hero-static
            d={pathD}
            fill="none"
            stroke="var(--color-signal)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <circle data-hero-static cx={start.x} cy={start.y} r="3.5" fill="var(--color-signal)" />

          {work.map((n, i) => (
            <a
              href={n.href}
              class="hero-node"
              data-hero-static
              aria-label={`${n.label} ${n.note}`}
              style={`animation-delay:${0.5 + i * 0.22}s`}
            >
              <circle cx={n.x} cy={n.y} r="15" fill="var(--color-signal)" fill-opacity="0.12" />
              <circle cx={n.x} cy={n.y} r="5.5" fill="var(--color-signal)" />
              <text
                x={n.x + n.dx}
                y={n.y + n.dy}
                text-anchor={n.anchor}
                font-family="var(--font-mono)"
                font-size="20"
                fill="var(--color-paper)"
                stroke="var(--color-void)"
                stroke-width="6"
                stroke-linejoin="round"
                paint-order="stroke"
              >{n.label}</text>
              <text
                x={n.x + n.dx}
                y={n.y + n.dy + 21}
                text-anchor={n.anchor}
                font-family="var(--font-mono)"
                font-size="17.5"
                fill="var(--color-quiet)"
                stroke="var(--color-void)"
                stroke-width="6"
                stroke-linejoin="round"
                paint-order="stroke"
              >{n.note}</text>
            </a>
          ))}
        </svg>
      </div>
    </div>
  </div>
</section>

<!--
  The same graph, for the screen most people will actually open this on.

  It is not in the hero on mobile because there is no room: the hero already runs 863px
  inside an 844px viewport, so anything added there pushes the evidence strip further out
  of sight. Given the choice between cramming the signature in and giving it a band of its
  own one scroll down, the band wins. It arrives before the first section either way.

  Compact rather than shrunken: no mesh, no secondary notes, four labels and the path.
  The nodes are the same anchors as the desktop version, so this is still navigation.
-->
<section aria-label="What I've built" class="lg:hidden bg-void border-t border-line">
  <div class="px-[clamp(1.25rem,5vw,5rem)] py-7">
    <p class="t-micro mb-3">Five years, four things</p>
    <svg viewBox="0 0 350 112" class="w-full h-auto" aria-labelledby="hero-graph-m">
      <title id="hero-graph-m">
        A sync pipeline, a CMDB, the rmine CLI and a workflow engine, connected as one path.
      </title>
      <path
        d={mobilePath}
        fill="none"
        stroke="var(--color-signal)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      {mobileNodes.map((n) => (
        <a href={n.href} class="hero-node" aria-label={`${n.label} ${n.note}`}>
          {/* A generous transparent hit area: the visible node is 10px across, which is
              nowhere near a thumb. */}
          <circle cx={n.x} cy={n.y} r="24" fill="transparent" />
          <circle cx={n.x} cy={n.y} r="13" fill="var(--color-signal)" fill-opacity="0.12" />
          <circle cx={n.x} cy={n.y} r="5" fill="var(--color-signal)" />
          <text
            x={n.x}
            y={n.y + 27}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size="12"
            fill="var(--color-paper)"
          >{n.label}</text>
        </a>
      ))}
    </svg>
  </div>
</section>

<script>
  import { createHeroScene } from '../lib/motion/heroScene';
  import { play, type Playback } from '../lib/motion/scene';
  import { fontsReady, motionAllowed, nextFrame, onAstroLifecycle } from '../lib/motion/trigger';

  const flags = window as Window & { __mbHeroPlayed?: boolean };

  onAstroLifecycle(() => {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root) return;
    const release = () => root.querySelector('[data-hero-pending]')?.removeAttribute('data-hero-pending');
    if (flags.__mbHeroPlayed || !motionAllowed() || !window.matchMedia('(min-width: 1024px)').matches) {
      release();
      return;
    }
    flags.__mbHeroPlayed = true;
    let playback: Playback | undefined;
    let cancelled = false;
    const stop = () => playback?.stop();
    window.addEventListener('resize', stop);
    fontsReady()
      .then(nextFrame)
      .then(() => {
        if (cancelled) return;
        let scene: ReturnType<typeof createHeroScene> = null;
        try {
          scene = createHeroScene(root);
        } catch {
          scene = null;
        }
        if (!scene) {
          release();
          return;
        }
        playback = play(scene);
        playback.done.then(() => window.removeEventListener('resize', stop));
      })
      .catch(release);
    return () => {
      cancelled = true;
      window.removeEventListener('resize', stop);
      stop();
    };
  });
</script>
