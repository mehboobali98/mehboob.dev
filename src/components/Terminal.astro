---
// Real output from a real binary, marked up as text rather than captured as an image:
// it stays selectable, it survives zoom, it costs nothing to load, and it can't go stale
// silently the way a screenshot does. The `$` on the command line is generated in CSS so
// copying the block gives you something you can actually paste.
interface Props {
  caption: string;
  command: string;
  // A plain string is printed as-is; { dim: true } greys it, for the parts of the output
  // that are chrome rather than content.
  output: (string | { text: string; dim?: boolean })[];
}

const { caption, command, output } = Astro.props;

function escapeHtml(value: string) {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

const terminalHtml = [
  `<span class="cmd terminal-line">${escapeHtml(command)}</span>`,
  ...output.map((line) => {
    const text = typeof line === 'string' ? line : line.text;
    const dim = typeof line !== 'string' && line.dim;
    return `<span class="terminal-line${dim ? ' dim' : ''}">${text ? escapeHtml(text) : '&nbsp;'}</span>`;
  }),
].join('');
---

<!-- tabindex on the pre: it scrolls sideways on narrow screens, and Shiki only adds that
     automatically to code blocks in posts. The figcaption already names it. -->
<figure class="terminal">
  <figcaption>{caption}</figcaption>
  <pre tabindex="0" set:html={terminalHtml}></pre>
</figure>
