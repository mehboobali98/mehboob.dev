---
// Features delivered per work-year, straight out of the rmine export that produced every
// other number in this section. One series, because the story is the trajectory and a
// second fill would only be there to look like a chart.
//
// "Work-year" is the year holding most of the logged hours, not Redmine's created_on.
// created_on is when a ticket was filed, which for long-lived specs puts the work in the
// wrong year entirely.
const years = [
  { year: '2021', total: 11 },
  { year: '2022', total: 11 },
  { year: '2023', total: 32 },
  { year: '2024', total: 38 },
  { year: '2025', total: 55 },
  // The export was pulled 29 July 2026, so this year is seven months, not twelve. Drawn
  // hollow and labelled, because a solid bar next to five full years would read as a
  // decline that didn't happen.
  { year: '2026', total: 23, partial: true },
];

const max = 55;
const bar = 12;
const gap = (100 - years.length * bar) / (years.length - 1);
const height = 236;
const baseline = 192;
const plotH = 150;
---

<figure>
  <figcaption class="t-micro mb-5">Features deployed per year</figcaption>
  <svg width="100%" height={height} class="block max-w-[34rem] overflow-visible" role="img" aria-labelledby="dc-title dc-desc">
    <title id="dc-title">Features deployed per year, 2021 to 2026</title>
    <desc id="dc-desc">
      11 in 2021, 11 in 2022, 32 in 2023, 38 in 2024, 55 in 2025, and 23 in the first seven
      months of 2026. 170 in total.
    </desc>

    {years.map((d, i) => {
      const h = Math.round((d.total / max) * plotH);
      const x = i * (bar + gap);
      const mid = `${x + bar / 2}%`;
      return (
        <>
          <rect
            x={`${x}%`}
            y={baseline - h}
            width={`${bar}%`}
            height={h}
            rx="4"
            fill={d.partial ? 'transparent' : 'var(--color-signal)'}
            stroke={d.partial ? 'var(--color-signal)' : 'none'}
            stroke-width={d.partial ? 1.5 : 0}
            stroke-dasharray={d.partial ? '4 3' : undefined}
          />
          <text
            x={mid}
            y={baseline - h - 10}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size="15"
            fill="var(--color-paper)"
          >{d.total}</text>
          <text
            x={mid}
            y={baseline + 20}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size="13"
            fill="var(--color-quiet)"
          >{d.year}</text>
          {d.partial && (
            <text
              x={mid}
              y={baseline + 37}
              text-anchor="middle"
              font-family="var(--font-mono)"
              font-size="12"
              fill="var(--color-quiet)"
            >to Jul</text>
          )}
        </>
      );
    })}

    <line
      x1="0"
      y1={baseline + 0.5}
      x2="100%"
      y2={baseline + 0.5}
      stroke="var(--color-line)"
      stroke-width="1"
    />
  </svg>
</figure>
