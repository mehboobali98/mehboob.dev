---
// Faithful to the shipped feature rather than to a generic idea of a graph. The CI types,
// the level structure and the traversal below all come from EZO's public documentation of
// the IT Graph: configuration items render as cards on a canvas, relationship lines carry
// a type and a direction, Level 1 shows direct connections, and each card expands to the
// next level. Supported CI types are Assets, Members, Software, Software Licenses,
// Purchase Orders, Contracts, Locations, Vendors and Tickets.
//
// The highlighted traversal answers a question the product exists to answer: which vendor
// contract covers the software installed on this server. Record names are shaped like real
// ones and name nothing real.
const hops = [
  { x: 44, y: 148, label: 'srv-014', tier: 'ASSET' },
  { x: 168, y: 176, label: 'SQL Server', tier: 'LEVEL 1' },
  { x: 300, y: 202, label: 'LIC-2291', tier: 'LEVEL 2' },
  { x: 424, y: 236, label: 'Microsoft', tier: 'LEVEL 3' },
];

// Related records off the highlighted path, each a real CI type.
const others = [
  { x: 158, y: 66, label: 'm.ali', type: 'member' },
  { x: 292, y: 44, label: 'INC-4821', type: 'ticket' },
  { x: 132, y: 258, label: 'HQ-Lahore', type: 'location' },
  { x: 408, y: 118, label: 'CTR-77', type: 'contract' },
];

const quietEdges = [
  [44, 148, 158, 66],
  [158, 66, 292, 44],
  [44, 148, 132, 258],
  [300, 202, 408, 118],
  [168, 176, 132, 258],
];

const pathD = hops.map((h, i) => `${i === 0 ? 'M' : 'L'}${h.x},${h.y}`).join(' ');
---

<figure>
  <svg
    viewBox="0 0 512 300"
    class="w-full h-auto"
    role="img"
    aria-labelledby="cmdb-title cmdb-desc"
  >
    <title id="cmdb-title">A three-level CMDB relationship traversal</title>
    <desc id="cmdb-desc">
      Starting from a server, the graph traverses to the software installed on it, then to
      that software's licence, then to the vendor behind the licence. A member, a ticket, a
      location and a contract sit off the highlighted path as related records.
    </desc>

    <g stroke="var(--color-line)" stroke-width="1">
      {quietEdges.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
    </g>

    <path
      d={pathD}
      fill="none"
      stroke="var(--color-signal)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    {others.map((n) => (
      <>
        <circle cx={n.x} cy={n.y} r="4" fill="var(--color-ink)" stroke="var(--color-line-strong)" stroke-width="1" />
        <text
          x={n.x}
          y={n.y - 12}
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.06em"
          fill="var(--color-quiet)"
        >{n.type}</text>
        <text
          x={n.x}
          y={n.y + 19}
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="11"
          fill="var(--color-quiet)"
        >{n.label}</text>
      </>
    ))}

    {hops.map((n) => (
      <>
        <circle cx={n.x} cy={n.y} r="6" fill="var(--color-signal)" />
        <text
          x={n.x}
          y={n.y - 15}
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="9"
          letter-spacing="0.08em"
          fill="var(--color-quiet)"
        >{n.tier}</text>
        <text
          x={n.x}
          y={n.y + 21}
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="12"
          fill="var(--color-paper)"
        >{n.label}</text>
      </>
    ))}
  </svg>

  <figcaption class="mt-5 max-w-[34rem] text-[0.8125rem] leading-relaxed text-quiet">
    Level 1 is what the graph shows by default. Each card expands to the next level, so this
    path answers which vendor contract covers the software on one server. Before it, every
    one of those links was a separate lookup. Drawn from the shipped feature, not a screenshot.
  </figcaption>
</figure>
