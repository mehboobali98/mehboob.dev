---
import Terminal from './Terminal.astro';

const projects = [
  {
    name: 'rmine',
    tag: 'Go',
    repo: 'mehboobali98/rmine',
    desc: 'Redmine CLI with a Claude Code skill built in, plus a companion spec-estimator skill (rmine-skills). Adopted by the team at 7Vals.',
    href: 'https://github.com/mehboobali98/rmine',
    cta: 'View on GitHub',
    post: '/blog/designing-a-cli-for-agents',
  },
  {
    name: 'bitwise_attributes',
    tag: 'Ruby gem',
    repo: 'mehboobali98/bitwise_attributes',
    desc: 'Packs boolean flag attributes into a single ActiveRecord integer column. Started as an internal pattern I used for two years before publishing it.',
    href: 'https://github.com/mehboobali98/bitwise_attributes',
    cta: 'View on GitHub',
    post: '/blog/two-years-before-i-published-it',
  },
];

// Fetched once at build time -- not client-side, so no runtime API calls or rate-limit
// risk for site visitors. Falls back to just the tag if GitHub is unreachable or rate-limits
// the build (e.g. repeated local builds in a short window).
async function fetchRepoStats(repo: string) {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: { 'User-Agent': 'mehboobali-portfolio-build', Accept: 'application/vnd.github+json' },
    });
    if (!res.ok) return null;
    const data = await res.json();
    const pushedAt = data.pushed_at ? new Date(data.pushed_at) : null;
    return {
      stars: typeof data.stargazers_count === 'number' ? data.stargazers_count : null,
      pushedAt,
    };
  } catch {
    return null;
  }
}

// A star count in low single digits reads as weaker than no star count at all, and it
// isn't the claim worth making about these repos anyway: one of them is running inside a
// team every day, which the description says and a number can't. Recency still earns its
// place, because "pushed today" is the thing that proves "maintained" in the heading.
const STAR_THRESHOLD = 25;

function timeAgo(date: Date | null) {
  if (!date) return null;
  const days = Math.floor((Date.now() - date.getTime()) / 86400000);
  if (days < 1) return 'today';
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months}mo ago`;
  return `${Math.floor(months / 12)}y ago`;
}

const stats = await Promise.all(projects.map((p) => fetchRepoStats(p.repo)));

// Verbatim from `rmine --help` on the current build of the CLI.
const rmineHelp = [
  'A command-line client for Redmine',
  '',
  { text: 'Available Commands:', dim: true },
  '  issue       Work with Redmine issues',
  '  project     Browse Redmine projects',
  '  skill       Manage the rmine Claude Code skill',
  '  time        Log and manage time entries',
  "  whoami      Show the active profile's user",
  '',
  { text: 'Flags:', dim: true },
  '  -o, --output string    table|json',
  '      --profile string   profile to use',
];

const alsoBuilt = [
  'A closed-loop agent that plans, tiers, implements, and opens a PR (or escalates) for a Redmine ticket, using the Claude Code SDK. Still a prototype, dry-run tested so far.',
  'A RAG-based Slack assistant that answers Customer Success questions from company blogs and Slack history. In use by the AssetSonar CSM team.',
  'Cursor rules and Claude Code skills for our Rails/React codebase, merged into the main repo and used by the whole engineering team',
];
---

<section id="open-source" class="bg-ink border-t border-line">
  <div class="band shell">
  <div class="measure">
    <p class="marker mb-6">Open source</p>
    <h2 class="t-display-2 text-paper">
      Public, verifiable, and maintained.
    </h2>
  </div>

  <div class="mt-12 grid sm:grid-cols-2 gap-5">
    {projects.map((p, i) => (
      <div
        data-reveal
        class="group flex flex-col p-8 border border-line rounded-lg hover:border-signal transition-colors bg-surface"
      >
        <!-- Wraps rather than overflowing: at the narrow end of the two-up grid,
             "bitwise_attributes" plus its language tag is wider than the card. -->
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="t-display-3 text-paper min-w-0">{p.name}</h3>
          <span class="font-mono text-[11px] text-quiet">{p.tag}</span>
        </div>
        <p class="mt-4 text-paper/80 leading-relaxed text-sm">{p.desc}</p>
        <div class="mt-auto pt-6 flex items-center justify-between gap-4">
          <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
            <a href={p.href} target="_blank" rel="noopener" class="tap text-signal hover:underline">
              {p.cta} &rarr;
            </a>
            {p.post && (
              <a href={p.post} class="tap text-quiet hover:text-signal transition-colors">
                Read the post &rarr;
              </a>
            )}
          </div>
          {stats[i] && (
            <p class="font-mono text-[11px] text-quiet flex items-center gap-3 shrink-0">
              {stats[i]!.stars !== null && stats[i]!.stars! >= STAR_THRESHOLD && (
                <span>&#9733; {stats[i]!.stars}</span>
              )}
              {stats[i]!.pushedAt && <span>pushed {timeAgo(stats[i]!.pushedAt)}</span>}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-16 section-grid">
    <div class="measure">
      <p class="t-micro mb-4">Why rmine exists</p>
      <p class="text-paper/80 leading-relaxed">
        I wanted to know what five years of my own ticket history actually said. Nothing made
        that easy, so I wrote something: a CLI in Go with a Claude Code skill built in, so an
        agent can query tickets and time logs on its own instead of me pasting API responses
        into a prompt.
      </p>
      <p class="mt-4 text-paper/80 leading-relaxed">
        The rest of the team runs it day to day, and the numbers further up this page came
        straight out of it. Not a demo. Just what the tool actually found.
      </p>
    </div>
    <div>
      <Terminal caption="rmine --help" command="rmine --help" output={rmineHelp} />
    </div>
  </div>

  <div class="mt-16">
    <p class="t-micro mb-6">Also built (internal)</p>
    <ul class="grid md:grid-cols-3 gap-x-8 gap-y-6">
      {alsoBuilt.map((item) => (
        <li class="text-sm text-paper/70 leading-relaxed pt-4 border-t border-line">
          {item}
        </li>
      ))}
    </ul>
  </div>
  </div>
</section>
