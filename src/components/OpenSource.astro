---
import { getCollection } from 'astro:content';
import AgentsDiagram from './AgentsDiagram.astro';
import Terminal from './Terminal.astro';

const projects = [
  {
    name: 'rmine',
    tag: 'Go',
    repo: 'mehboobali98/rmine',
    desc: 'Redmine CLI with JSON output and a Claude Code skill built in. Used by the team at EZO.',
    detail: 'It started as a way to inspect five years of ticket history. The team now uses the same binary day to day, and the delivery numbers above came straight out of it.',
    href: 'https://github.com/mehboobali98/rmine',
    cta: 'View on GitHub',
    post: '/blog/designing-a-cli-for-agents/',
  },
  {
    name: 'rmine-skills',
    tag: 'Claude Code plugin',
    repo: 'mehboobali98/rmine-skills',
    desc: 'Seven Claude Code skills built on rmine, used by the team at EZO. They estimate tickets, draft time logs from git, check sprint capacity and record a feature demo for the ticket.',
    detail: "Its /estimate skill hands a ticket to three subagents, and none of them can write a file. Most of the design went into what each one isn't allowed to see.",
    href: 'https://github.com/mehboobali98/rmine-skills',
    cta: 'View on GitHub',
    post: '/blog/three-agents-that-dont-trust-each-other/',
  },
  {
    name: 'bitwise_attributes',
    tag: 'Ruby gem',
    repo: 'mehboobali98/bitwise_attributes',
    desc: 'Packs boolean flag attributes into a single ActiveRecord integer column. Started as an internal pattern I used for two years before publishing it.',
    href: 'https://github.com/mehboobali98/bitwise_attributes',
    cta: 'View on GitHub',
    post: '/blog/two-years-before-i-published-it/',
  },
  {
    name: 'loredock',
    tag: 'Python',
    repo: 'mehboobali98/loredock',
    desc: 'A local RAG kit on AnythingLLM and Ollama that answers with sources. Its evaluation asks 30 questions, some it must refuse, and only a human review can pass the quality gate.',
    href: 'https://github.com/mehboobali98/loredock',
    cta: 'View on GitHub',
  },
  // No adoption line on this one. The other two earned theirs (a team runs rmine daily,
  // the gem was internal for two years) and this is a tool with one user, so the claim
  // it can honestly make is about the design constraint instead.
  {
    name: 'job-search-agent',
    tag: 'Node.js',
    repo: 'mehboobali98/job-search-agent',
    desc: "Job discovery for Codex. The finder and judge agents can't write; one deterministic script owns every tracker change, and it never submits an application.",
    href: 'https://github.com/mehboobali98/job-search-agent',
    cta: 'View on GitHub',
    post: '/blog/every-fixture-was-one-line-long/',
  },
  // One user again, so the claim is the design: a clip is code, not a recording.
  {
    name: 'clip-studio',
    tag: 'Claude Code plugin',
    repo: 'mehboobali98/clip-studio',
    desc: 'Short videos as code. Every frame is a pure function of time, so Playwright captures it frame by frame and ffmpeg encodes it: nothing is screen-recorded, and a clip diffs like the rest of the repo.',
    href: 'https://github.com/mehboobali98/clip-studio',
    cta: 'View on GitHub',
  },
];

// Fetched once at build time -- not client-side, so no runtime API calls or rate-limit
// risk for site visitors. Falls back to just the tag if GitHub is unreachable or rate-limits
// the build (e.g. repeated local builds in a short window).
async function fetchRepoStats(repo: string) {
  try {
    // Unauthenticated the GitHub API allows 60 requests an hour per IP, which CI runners
    // and build hosts share, so this rate-limits far more often than it does locally. The
    // catch below handles that, but the fallback quietly drops the "pushed" date
    // that this section's own heading is claiming. A token raises the limit to 1000/hr;
    // when there isn't one the behaviour is exactly what it was before.
    const token = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        'User-Agent': 'mehboobali-portfolio-build',
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });
    if (!res.ok) return null;
    const data = await res.json();
    const pushedAt = data.pushed_at ? new Date(data.pushed_at) : null;
    return {
      stars: typeof data.stargazers_count === 'number' ? data.stargazers_count : null,
      pushedAt,
    };
  } catch {
    return null;
  }
}

// A star count in low single digits reads as weaker than no star count at all, and it
// isn't the claim worth making about these repos anyway: one of them is running inside a
// team every day, which the description says and a number can't. Recency still earns its
// place, because the last-pushed date is the thing that proves "maintained" in the heading.
const STAR_THRESHOLD = 25;

// An absolute date rather than "11d ago": the page is built on push, not on a schedule,
// so a relative age is only true on the day of the deploy and then silently goes stale.
function pushedOn(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

const stats = await Promise.all(projects.map((p) => fetchRepoStats(p.repo)));

// A verbatim excerpt from `rmine --help` on the current build of the CLI. Enough to
// prove the interface is real without turning the homepage into another documentation page.
const rmineHelp = [
  'A command-line client for Redmine',
  '',
  { text: 'Available Commands:', dim: true },
  '  issue       Work with Redmine issues',
  '  skill       Manage the rmine Claude Code skill',
  '  time        Log and manage time entries',
];

// The "Inside the company" list moved to Trajectory: internal adoption is career-scope
// evidence, not open source.

// A draft post has no route, so a card linking one would send people to a 404. Every
// other surface on the site filters on `!data.draft` before linking a post; this does
// the same, which is what lets a project card ship before its write-up is published.
const publishedPosts = new Set(
  (await getCollection('blog', ({ data }) => !data.draft)).map((post) => `/blog/${post.id}/`),
);

const withStats = projects.map((project, index) => ({ project, stat: stats[index] }));
const featured = withStats.slice(0, 2);
const secondary = withStats.slice(2);
---

<section id="open-source" class="bg-void border-t border-line">
  <div class="band band--compact shell">
    <div class="measure">
      <p class="marker mb-6">Open source</p>
      <h2 class="t-display-2 text-paper">
        Things you can inspect.
      </h2>
    </div>

    <div class="mt-10 grid gap-5">
      <div class="grid xl:grid-cols-2 gap-5 items-stretch">
        {featured.map(({ project, stat }) => (
          <article
            data-reveal
            class="group flex flex-col min-w-0 p-7 sm:p-9 border border-line rounded-lg hover:border-signal transition-colors bg-surface"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="t-display-3 text-paper">{project.name}</h3>
              <span class="font-mono text-xs text-quiet">{project.tag}</span>
            </div>
            <p class="mt-4 measure text-paper/80 leading-relaxed">{project.desc}</p>
            <p class="mt-4 measure-sm text-sm text-paper/65 leading-relaxed">{project.detail}</p>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
                <a href={project.href} target="_blank" rel="noopener" class="tap text-signal hover:underline">
                  {project.cta} &rarr;
                </a>
                {project.post && publishedPosts.has(project.post) && (
                  <a href={project.post} class="tap text-quiet hover:text-signal transition-colors">
                    Read the post &rarr;
                  </a>
                )}
              </div>
              {stat && (
                <p class="font-mono text-xs text-quiet flex items-center gap-3 shrink-0">
                  {stat.stars !== null && stat.stars >= STAR_THRESHOLD && (
                    <span>&#9733; {stat.stars}</span>
                  )}
                  {stat.pushedAt && <span>pushed <time datetime={stat.pushedAt.toISOString()}>{pushedOn(stat.pushedAt)}</time></span>}
                </p>
              )}
            </div>

            <div class="mt-auto pt-8">
              {project.name === 'rmine'
                ? <Terminal caption="Real output excerpt · rmine --help" command="rmine --help" output={rmineHelp} hang={14} />
                : <AgentsDiagram />}
            </div>
          </article>
        ))}
      </div>

      <ul class="mt-5 flex flex-col border-b border-line">
        {secondary.map(({ project, stat }) => (
          <li data-reveal class="repo-row border-t border-line py-5 sm:py-6">
            <div class="grid gap-1">
              <h3 class="font-display wonk font-semibold text-xl text-paper min-w-0 break-words">
                {project.name}
              </h3>
              <span class="font-mono text-xs text-quiet">{project.tag}</span>
            </div>
            <p class="measure-sm text-paper/75 leading-relaxed text-sm">{project.desc}</p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs">
              <a href={project.href} target="_blank" rel="noopener" class="tap text-signal hover:underline">
                {project.cta} &rarr;
              </a>
              {project.post && publishedPosts.has(project.post) && (
                <a href={project.post} class="tap text-quiet hover:text-signal transition-colors">
                  Read the post &rarr;
                </a>
              )}
              {stat?.pushedAt && (
                <span class="text-quiet">pushed <time datetime={stat.pushedAt.toISOString()}>{pushedOn(stat.pushedAt)}</time></span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { mountScene } from '../lib/motion/mount';
  import { onAstroLifecycle } from '../lib/motion/trigger';

  onAstroLifecycle(() => {
    const host = document.querySelector<HTMLElement>('[data-scene="agents"]');
    const button = host?.closest('figure')?.querySelector<HTMLButtonElement>('[data-scene-replay]');
    return host && button ? mountScene(host, button, 'subagents', () => import('../lib/motion/agentsScene')) : undefined;
  });
</script>

<style>
  .repo-row {
    display: grid;
    gap: 0.6rem 3rem;
  }

  @media (min-width: 1024px) {
    .repo-row {
      grid-template-columns: 15rem minmax(0, 1fr);
      grid-template-areas: "name desc" "name links";
      align-items: baseline;
    }

    .repo-row > :nth-child(1) {
      grid-area: name;
    }

    .repo-row > :nth-child(2) {
      grid-area: desc;
    }

    .repo-row > :nth-child(3) {
      grid-area: links;
    }
  }

  @media (min-width: 1280px) {
    .repo-row {
      grid-template-columns: 15rem minmax(0, 26rem) minmax(0, 1fr);
      grid-template-areas: "name desc links";
    }
  }
</style>
