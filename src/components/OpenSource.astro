---
import { getCollection } from 'astro:content';
import Terminal from './Terminal.astro';

const projects = [
  {
    name: 'rmine',
    tag: 'Go',
    repo: 'mehboobali98/rmine',
    desc: 'Redmine CLI with a Claude Code skill built in, plus a companion spec-estimator skill (rmine-skills). Adopted by the team at 7Vals.',
    href: 'https://github.com/mehboobali98/rmine',
    cta: 'View on GitHub',
    post: '/blog/designing-a-cli-for-agents',
  },
  {
    name: 'bitwise_attributes',
    tag: 'Ruby gem',
    repo: 'mehboobali98/bitwise_attributes',
    desc: 'Packs boolean flag attributes into a single ActiveRecord integer column. Started as an internal pattern I used for two years before publishing it.',
    href: 'https://github.com/mehboobali98/bitwise_attributes',
    cta: 'View on GitHub',
    post: '/blog/two-years-before-i-published-it',
  },
  // No adoption line on this one. The other two earned theirs (a team runs rmine daily,
  // the gem was internal for two years) and this is a tool with one user, so the claim
  // it can honestly make is about the design constraint instead.
  {
    name: 'job-search-agent',
    tag: 'Node.js',
    repo: 'mehboobali98/job-search-agent',
    desc: "Job discovery for Codex. The finder and judge agents can't write; one deterministic script owns every tracker change, and it never submits an application.",
    href: 'https://github.com/mehboobali98/job-search-agent',
    cta: 'View on GitHub',
    post: '/blog/every-fixture-was-one-line-long',
  },
];

// Fetched once at build time -- not client-side, so no runtime API calls or rate-limit
// risk for site visitors. Falls back to just the tag if GitHub is unreachable or rate-limits
// the build (e.g. repeated local builds in a short window).
async function fetchRepoStats(repo: string) {
  try {
    // Unauthenticated the GitHub API allows 60 requests an hour per IP, which CI runners
    // and build hosts share, so this rate-limits far more often than it does locally. The
    // catch below handles that, but the fallback quietly drops the "pushed today" line
    // that this section's own heading is claiming. A token raises the limit to 1000/hr;
    // when there isn't one the behaviour is exactly what it was before.
    const token = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        'User-Agent': 'mehboobali-portfolio-build',
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });
    if (!res.ok) return null;
    const data = await res.json();
    const pushedAt = data.pushed_at ? new Date(data.pushed_at) : null;
    return {
      stars: typeof data.stargazers_count === 'number' ? data.stargazers_count : null,
      pushedAt,
    };
  } catch {
    return null;
  }
}

// A star count in low single digits reads as weaker than no star count at all, and it
// isn't the claim worth making about these repos anyway: one of them is running inside a
// team every day, which the description says and a number can't. Recency still earns its
// place, because "pushed today" is the thing that proves "maintained" in the heading.
const STAR_THRESHOLD = 25;

function timeAgo(date: Date | null) {
  if (!date) return null;
  const days = Math.floor((Date.now() - date.getTime()) / 86400000);
  if (days < 1) return 'today';
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months}mo ago`;
  return `${Math.floor(months / 12)}y ago`;
}

const stats = await Promise.all(projects.map((p) => fetchRepoStats(p.repo)));

// Verbatim from `rmine --help` on the current build of the CLI.
const rmineHelp = [
  'A command-line client for Redmine',
  '',
  { text: 'Available Commands:', dim: true },
  '  issue       Work with Redmine issues',
  '  project     Browse Redmine projects',
  '  skill       Manage the rmine Claude Code skill',
  '  time        Log and manage time entries',
  "  whoami      Show the active profile's user",
  '',
  { text: 'Flags:', dim: true },
  '  -o, --output string    table|json',
  '      --profile string   profile to use',
];

// The "Inside the company" list moved to Trajectory: internal adoption is career-scope
// evidence, not open source.

// A draft post has no route, so a card linking one would send people to a 404. Every
// other surface on the site filters on `!data.draft` before linking a post; this does
// the same, which is what lets a project card ship before its write-up is published.
const publishedPosts = new Set(
  (await getCollection('blog', ({ data }) => !data.draft)).map((post) => `/blog/${post.id}`),
);

const featured = projects[0];
const featuredStat = stats[0];
const secondary = projects.slice(1).map((project, index) => ({
  project,
  stat: stats[index + 1],
}));
---

<section id="open-source" class="bg-ink border-t border-line">
  <div class="band shell">
    <div class="measure">
      <p class="marker mb-6">Open source</p>
      <h2 class="t-display-2 text-paper">
        Public, verifiable, and maintained.
      </h2>
    </div>

    <div class="mt-12 grid xl:grid-cols-[minmax(0,1.18fr)_minmax(22rem,0.82fr)] gap-5 items-stretch">
      <article
        data-reveal
        class="group min-w-0 p-7 sm:p-9 border border-line rounded-lg hover:border-signal transition-colors bg-surface"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="t-display-3 text-paper">{featured.name}</h3>
          <span class="font-mono text-[11px] text-quiet">{featured.tag}</span>
        </div>
        <p class="mt-4 max-w-[38rem] text-paper/80 leading-relaxed">{featured.desc}</p>
        <p class="mt-4 max-w-[38rem] text-sm text-paper/65 leading-relaxed">
          It started as a way to inspect five years of ticket history. The team now uses the same
          binary day to day, and the delivery numbers above came straight out of it.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
            <a href={featured.href} target="_blank" rel="noopener" class="tap text-signal hover:underline">
              {featured.cta} &rarr;
            </a>
            {featured.post && publishedPosts.has(featured.post) && (
              <a href={featured.post} class="tap text-quiet hover:text-signal transition-colors">
                Read the post &rarr;
              </a>
            )}
          </div>
          {featuredStat && (
            <p class="font-mono text-[11px] text-quiet flex items-center gap-3 shrink-0">
              {featuredStat.stars !== null && featuredStat.stars >= STAR_THRESHOLD && (
                <span>&#9733; {featuredStat.stars}</span>
              )}
              {featuredStat.pushedAt && <span>pushed {timeAgo(featuredStat.pushedAt)}</span>}
            </p>
          )}
        </div>

        <div class="mt-8">
          <Terminal caption="rmine --help" command="rmine --help" output={rmineHelp} />
        </div>
      </article>

      <div class="grid gap-5">
        {secondary.map(({ project, stat }) => (
          <article
            data-reveal
            class="group flex flex-col min-w-0 p-7 border border-line rounded-lg hover:border-signal transition-colors bg-surface"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display wonk font-semibold text-2xl text-paper min-w-0 break-words">
                {project.name}
              </h3>
              <span class="font-mono text-[11px] text-quiet">{project.tag}</span>
            </div>
            <p class="mt-4 text-paper/75 leading-relaxed text-sm">{project.desc}</p>
            <div class="mt-auto pt-5 flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
                <a href={project.href} target="_blank" rel="noopener" class="tap text-signal hover:underline">
                  {project.cta} &rarr;
                </a>
                {project.post && publishedPosts.has(project.post) && (
                  <a href={project.post} class="tap text-quiet hover:text-signal transition-colors">
                    Read the post &rarr;
                  </a>
                )}
              </div>
              {stat?.pushedAt && (
                <p class="font-mono text-[11px] text-quiet shrink-0">pushed {timeAgo(stat.pushedAt)}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
