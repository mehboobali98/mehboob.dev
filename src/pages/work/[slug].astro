---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import CmdbGraph from '../../components/CmdbGraph.astro';
import SyncPipeline from '../../components/SyncPipeline.astro';
import WorkflowGraph from '../../components/WorkflowGraph.astro';
import { caseStudies, type CaseStudy } from '../../data/caseStudies';

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props as { study: CaseStudy };
const index = caseStudies.findIndex((item) => item.slug === study.slug);
const previous = index > 0 ? caseStudies[index - 1] : undefined;
const next = index < caseStudies.length - 1 ? caseStudies[index + 1] : undefined;
const accountability = [
  { label: 'My part', body: study.accountability.mine },
  { label: "The team's part", body: study.accountability.team },
  { label: 'Hardest trade-off', body: study.accountability.tradeoff },
  { label: "What I'd do earlier", body: study.accountability.hindsight },
];
const summary = [
  { label: 'Role', body: study.summary.role },
  { label: 'Constraint', body: study.summary.constraint },
  { label: 'Decision', body: study.summary.decision },
  {
    label: 'Result',
    body: study.summary.result.value,
    note: study.summary.result.note,
    evidenceNeeded: study.summary.result.evidenceNeeded,
  },
];
---

<Layout
  title={`${study.title} | Mehboob Ali`}
  description={study.description}
  ogImage={`/og/work/${study.slug}.png`}
>
  <Nav />
  <main id="main" tabindex="-1">
    <article>
      <header class="band band--dense shell case-hero">
        <a href="/#work" class="tap font-mono text-xs text-quiet hover:text-signal transition-colors">
          &larr; Selected work
        </a>
        <p class="marker mt-10 mb-5">{study.flagship ? `Flagship · ${study.eyebrow}` : study.eyebrow}</p>
        <h1 class="t-display-1 text-paper max-w-[19ch]">{study.title}</h1>
        <p class="mt-6 text-paper/80 leading-relaxed max-w-[42rem]" style="font-size: var(--type-body-lg)">
          {study.description}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {study.stack.map((item) => <span class="case-pill">{item}</span>)}
        </div>
      </header>

      <section aria-label="Project summary" class="border-y border-line bg-surface">
        <dl class="shell evidence-grid">
          {summary.map((item) => (
            <div class:list={[item.evidenceNeeded && 'needs-evidence']}>
              <dt>{item.label}</dt>
              <dd>
                {item.body}
                {item.note && <span class="evidence-note">{item.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="band shell">
        <div class="case-visual">
          <div class="artifact-heading">
            <p class="t-micro">Sanitized artifact</p>
            <h2>{study.artifactTitle}</h2>
          </div>
          {study.visual === 'sync' && <SyncPipeline />}
          {study.visual === 'workflow' && (
            <div>
              <WorkflowGraph />
              <p class="artifact-caption">
                Reconstructed from EZO’s public Automation Engine documentation. Labels are illustrative; no customer data is shown.
              </p>
            </div>
          )}
          {study.visual === 'cmdb' && <CmdbGraph />}
        </div>

        <section class="mt-10" aria-labelledby="accountability-heading">
          <h2 id="accountability-heading" class="sr-only">Ownership and reflection</h2>
          <div class="accountability-grid">
            {accountability.map((item) => (
              <div>
                <p class="t-micro">{item.label}</p>
                <p class="mt-3 text-sm leading-relaxed text-paper/75">{item.body}</p>
              </div>
            ))}
          </div>
        </section>

        <div class="case-copy mt-16 lg:mt-24">
          <section>
            <p class="t-micro">01 · Constraint</p>
            <h2>What was breaking</h2>
            <p>{study.challenge}</p>
          </section>
          <section>
            <p class="t-micro">02 · Decisions</p>
            <h2>How I approached it</h2>
            <p>{study.approach}</p>
          </section>
          <section>
            <p class="t-micro">03 · Consequence</p>
            <h2>What changed</h2>
            <p>{study.result}</p>
          </section>
        </div>

        {(study.proof || study.post) && (
          <div class="mt-16 pt-8 border-t border-line flex flex-wrap gap-x-8 gap-y-2">
            {study.proof && (
              <a href={study.proof.href} target="_blank" rel="noopener" class="proof-link tap">
                {study.proof.label} &rarr;
              </a>
            )}
            {study.post && (
              <a href={study.post} class="proof-link tap">Read the engineering note &rarr;</a>
            )}
          </div>
        )}
      </section>

      <nav aria-label="Other case studies" class="border-t border-line bg-void">
        <div class="shell case-pagination">
          {previous ? (
            <a href={`/work/${previous.slug}/`}>
              <span>Previous case study</span>
              <strong>&larr; {previous.title}</strong>
            </a>
          ) : <span></span>}
          {next && (
            <a href={`/work/${next.slug}/`} class="text-right">
              <span>Next case study</span>
              <strong>{next.title} &rarr;</strong>
            </a>
          )}
        </div>
      </nav>
    </article>
  </main>
</Layout>

<style>
  .case-pill {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .evidence-grid > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    min-width: 0;
    padding: 1.15rem clamp(1.25rem, 5vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .evidence-grid > div:last-child {
    border-bottom: 0;
  }

  .evidence-grid dt {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-quiet);
  }

  .evidence-grid dd {
    margin: 0;
    color: var(--color-paper);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .evidence-note {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-quiet);
    font-size: var(--type-micro);
    line-height: 1.55;
  }

  .needs-evidence .evidence-note {
    color: var(--color-signal);
  }

  .case-visual {
    padding: clamp(1.5rem, 5vw, 5rem);
    border: 1px solid var(--color-line);
    border-radius: 0.625rem;
    background: var(--color-surface);
  }

  .artifact-heading {
    display: grid;
    gap: 0.65rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .artifact-heading h2 {
    max-width: 28ch;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-variation-settings: "WONK" 1;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .artifact-caption {
    margin-top: 1.25rem;
    max-width: 34rem;
    color: var(--color-quiet);
    font-size: var(--type-meta);
    line-height: 1.6;
  }

  .accountability-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-line);
  }

  .accountability-grid > div {
    min-width: 0;
    padding: 1.5rem;
    background: var(--color-ink);
  }

  .case-copy {
    display: grid;
    gap: 4rem;
    max-width: 70rem;
  }

  .case-copy section {
    display: grid;
    gap: 1rem 4rem;
  }

  .case-copy h2 {
    font-family: var(--font-display);
    font-variation-settings: "WONK" 1;
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    color: var(--color-paper);
  }

  .case-copy p:last-child {
    max-width: 38rem;
    color: color-mix(in srgb, var(--color-paper) 80%, transparent);
    line-height: 1.75;
  }

  .case-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .case-pagination a {
    padding: 2.5rem clamp(1.25rem, 5vw, 5rem);
    transition: background-color 0.2s ease;
  }

  .case-pagination a:hover {
    background: var(--color-surface);
  }

  .case-pagination span {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-quiet);
  }

  .case-pagination strong {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-paper);
  }

  @media (min-width: 640px) {
    .evidence-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .evidence-grid > div {
      display: block;
      padding-block: 1.5rem;
      border-right: 1px solid var(--color-line);
    }

    .evidence-grid > div:nth-child(2n) {
      border-right: 0;
    }

    .evidence-grid > div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-line);
    }

    .evidence-grid > div:nth-child(n + 3) {
      border-bottom: 0;
    }

    .evidence-grid dd {
      margin-top: 0.55rem;
    }

  }

  @media (min-width: 900px) {
    .case-copy section {
      grid-template-columns: 9rem 16rem minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (min-width: 1100px) {
    .evidence-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .evidence-grid > div,
    .evidence-grid > div:nth-child(-n + 2) {
      border-bottom: 0;
    }

    .evidence-grid > div:nth-child(2n) {
      border-right: 1px solid var(--color-line);
    }

    .evidence-grid > div:last-child {
      border-right: 0;
    }
  }

  @media (max-width: 540px) {
    .case-pagination {
      grid-template-columns: 1fr;
    }

    .accountability-grid {
      grid-template-columns: 1fr;
    }

    .case-pagination > span:empty {
      display: none;
    }

    .case-pagination a + a {
      border-top: 1px solid var(--color-line);
    }
  }
</style>
