---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PostRow from '../../components/PostRow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout
  title="Writing | Mehboob Ali"
  description="Notes on backend systems, performance work, and the tooling around shipping software."
>
  <Nav />
  <main class="lg:ml-[300px]">
    <section class="px-6 sm:px-12 lg:px-20 py-20 lg:py-28">
      <p class="font-mono text-xs text-signal tracking-widest mb-3">WRITING</p>
      <h1 class="font-display wonk font-semibold text-3xl sm:text-5xl text-paper max-w-2xl leading-[1.05]">
        The long version of things that didn't fit in a case study.
      </h1>

      {posts.length === 0 ? (
        <p class="mt-10 text-paper/70 max-w-xl leading-relaxed">Nothing published yet.</p>
      ) : (
        <div class="mt-16 max-w-3xl flex flex-col">
          {posts.map((post) => <PostRow post={post} as="h2" />)}
          <div class="border-t border-line"></div>
        </div>
      )}

      <p class="mt-14 font-mono text-xs text-quiet">
        <a href="/rss.xml" class="hover:text-signal transition-colors">RSS &rarr;</a>
      </p>
    </section>
  </main>
</Layout>
