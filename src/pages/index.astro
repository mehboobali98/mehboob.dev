---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Trajectory from '../components/Trajectory.astro';
import OpenSource from '../components/OpenSource.astro';
import Writing from '../components/Writing.astro';
import Numbers from '../components/Numbers.astro';
import Contact from '../components/Contact.astro';

// Work opens the narrative; the evidence wall then resets the pace before career,
// public work, and writing move toward the contact close.
---

<Layout>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <CaseStudies />
    <!-- A visual reset after the long-form work: evidence before chronology. -->
    <Numbers />
    <Trajectory />
    <OpenSource />
    <Writing />
    <Contact />
  </main>
</Layout>
