# Read by Cloudflare at deploy time; not served itself.

# /_astro filenames are content-hashed, so they can never go stale. Cloudflare's default
# for static assets is max-age=0, must-revalidate, which was making every repeat visit
# re-check the stylesheet and all five font files. Deliberately not applied to /resume/*
# or /og.png, which keep stable names and get replaced in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # 'self' is a real boundary here: fonts are self-hosted, there is no analytics, and the
  # GitHub API call happens at build time. 'unsafe-inline' is required by the scroll-reveal
  # script and the inline style attributes; hashing them would break on the next build.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
